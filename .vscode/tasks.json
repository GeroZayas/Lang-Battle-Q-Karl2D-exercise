{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "odin-build-and-run",
      "type": "shell",
      "command": "odin build . -out:./builds/main && ./builds/main",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "odin-build",
      "type": "shell",
      "command": "odin build . -out:./builds/main",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "odin: build debug",
      "type": "shell",
      "command": "odin",
      "args": ["build", ".", "-debug", "-o:none", "-out:./builds/main"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "odin: build debug scratch_buffer",
      "type": "shell",
      "command": "odin",
      "args": ["build", "scratch_buffer/scratch_buffer.odin", "-file","-debug", "-o:none", "-out:./scratch_buffer/scratch_buffer"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
